<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24–25 兜底圆形启动图标（android:roundIcon 自 API 25 起使用）：
  · 圆形纸底 = @drawable/ic_launcher_background_round（card-pure #FFFFFF → paper-cream #F7F5F0，
    oval 形状，避免旧启动器显示方形直角）；
  · logo = @drawable/ic_launcher（新品牌立方体 + Z，1.0 满幅，立方体完全落在圆形底内）；
  · API 26+ 优先匹配 mipmap-anydpi-v26/ic_launcher_round.xml 的自适应图标。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background_round" />
    <item
        android:drawable="@drawable/ic_launcher"
        android:gravity="center"
        android:width="108dp"
        android:height="108dp" />
</layer-list>
