<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24–25 兜底启动图标（B3-4）：
  minSdk=24，自适应图标要求 API 26+；此层用 layer-list 合成「品牌渐变底 + 居中 logo」
  供 API 24–25 系统/启动器加载（密度无关 anydpi，随系统密度缩放）。
  API 26+ 优先匹配 mipmap-anydpi-v26/ic_launcher.xml 的自适应图标。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item
        android:drawable="@drawable/ic_launcher"
        android:gravity="center"
        android:width="36dp"
        android:height="36dp" />
</layer-list>
