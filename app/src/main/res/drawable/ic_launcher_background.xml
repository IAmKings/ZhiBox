<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应启动图标背景层（新品牌浅纸色）：
  · 色值来源：根目录 DESIGN.md「colors」——paper-cream #F7F5F0、card-pure #FFFFFF；
  · 前景是深色立方体（#30332F / #222522 / #121412，见 ic_launcher_foreground），
    浅底对比度：顶面 11.8:1、左面 14.2:1、右面 17.0:1，均远高于 WCAG AA 的 4.5:1；
    #FFFFFF → #F7F5F0 的极淡暖色渐变不会削弱该对比度（最浅处反而更高）；
  · 315° 线性渐变模拟纸面受光的方向感，幅度控制在品牌色板内，不引入新的中间色；
  · 108dp 自适应画布全幅铺满，由启动器按圆形/圆角矩形/水滴等形状裁切。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#F7F5F0"
        android:startColor="#FFFFFF"
        android:type="linear" />
</shape>
