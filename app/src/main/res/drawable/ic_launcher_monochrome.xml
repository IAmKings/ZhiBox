<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 主题化图标（Themed icon）单色层：
  · 只保留单一填充色 #FFFFFFFF（card-pure），系统会按「壁纸取色 / 主题色」重新着色；
    因此这里不写渐变、不写 filter，也不靠 alpha 叠层表达层次（VectorDrawable 限制 + 主题化语义要求）。
  · 语义靠负空间表达：立方体圆角六边形轮廓实心，Z 字形用 fillType=evenOdd 镂空，
    主题化后仍可读出「立方体 + Z」的品牌结构；单色层在任意主题色下都保持同一轮廓。
  · 几何来源：轮廓路径 = zhibox-icon.svg 的 cubeClip（与 ic_launcher_foreground 的 clip-path 逐字一致），
    Z 路径 = 前景白色 monogram 路径；两处几何若调整需同步修改本文件。
  · 安全区与前景层一致：group 以 (512,512) 为轴心缩放 0.76，使外接半径 403 × 0.76 ≈ 306
    视口单位（32.3dp，实测 31.3dp）落入中央 66dp 安全圆内，圆形/水滴形蒙版不会裁角；
    依据的完整推导见 ic_launcher_foreground.xml 顶部注释。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 与前景同样的 0.76 安全区内缩，保证主题化图标与普通图标轮廓位置一致 -->
    <group
        android:scaleX="0.76"
        android:scaleY="0.76"
        android:pivotX="512"
        android:pivotY="512">

        <!-- 第一段：立方体轮廓（实心）；第二段：Z 字形子路径，evenOdd 交点奇偶规则使其成为镂空 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M496,128 Q512,119 528,128 L835,306 Q853,317 853,338 V685 Q853,706 835,717 L530,893 Q512,903 494,893 L189,717 Q171,706 171,685 V338 Q171,317 189,306 Z M418,646 Q418,640 424,640 H600 Q606,640 606,646 V668 Q606,672 602,676 L481,774 H600 Q606,774 606,780 V800 Q606,806 600,806 H424 Q418,806 418,800 V778 Q418,774 423,770 L544,672 H424 Q418,672 418,666 Z" />
    </group>
</vector>
