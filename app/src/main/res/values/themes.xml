<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 单 Activity 应用：XML 侧仅需无标题栏基础主题，实际配色由 Compose Theme 提供。
         B3-3：windowBackground 与 Compose LightColors.background 对齐，消除冷启动闪白。 -->
    <style name="Theme.ZhiBox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/zhibox_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
