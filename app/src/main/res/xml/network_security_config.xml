<?xml version="1.0" encoding="utf-8"?>
<!--
  P1-10 网络安全配置（全局 TLS + 模型下载域名显式策略）

  背景：本应用「本地优先 / 离线可用」。联网路径包括用户显式触发的模型下载与
  网页导入，以及用户配置并同意启用后的 OpenAI-compatible LLM 请求；三者均只允许 HTTPS。

  策略：
  1. 默认（base-config）禁止一切明文 HTTP：`cleartextTrafficPermitted="false"`，
     即任意域名的 http:// 都会被系统直接拒绝，防降级/劫持。
  2. 模型下载域名 hf-mirror.com（含子域）有额外显式策略，同样只允许 HTTPS；
     网页导入与 LLM 端点使用 base-config，并由各自代码做 HTTPS/重定向校验。
     Android 的 TrustManager 默认信任系统 CA，
     这里显式只信任 system 证书（不含 user 安装证书，降低中间人风险）。
  3. 与代码侧 ModelDownloader、WebPageFetcher、OpenAiCompatibleLlmProvider 校验形成双保险。

  依据：docs/CODE_QUALITY_REVIEW.md P1-10；docs/review/infra.md P1-1。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 模型下载域名显式策略：仅 HTTPS，禁止明文 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">hf-mirror.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
