<?xml version="1.0" encoding="utf-8"?>
<!--
  深色基础主题（API 24–30 启动页）：windowBackground 同时引用 zhibox_launch_background，
  其中底色取自 values-night/colors.xml，图标底盘固定浅暖白，避免曜石 logo 融进深色底。
  Compose 侧仍由 isSystemInDarkTheme() 选择 DarkColors。
-->
<resources>
    <style name="Theme.ZhiBox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/zhibox_launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
