<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      P1-W1-5 起引入：应用内唯一联网路径是"模型下载器"（显式用户触发的下载，
      URL + SHA-256 校验 + 断点续传）。检索/导入/嵌入全链路离线可用。
      依据：docs/SAG_Android_MVP_Implementation_Plan_v1.0.md P1-W1-5 / P1-W2-5
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      P1-10 隐私边界：
      · allowBackup="false"：个人知识库（SQLite 中的原文 chunk / 向量 / 来源、
        SharedPreferences 中的 SAF 授权与模型偏好）禁止进入 Android Auto Backup
        （默认会随用户 Google 账户上云，与「本地优先 / 离线」定位冲突）。
        跨设备迁移只走产品自带的 KnowledgeBackup（用户显式导出/导入）。
      · networkSecurityConfig：显式禁止明文流量，仅放行模型下载域名 hf-mirror.com(HTTPS)，
        详见 res/xml/network_security_config.xml。
    -->
    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhiBox">

        <!-- GPU delegate（demo 保真差异②，2026-10-16 补齐）：Android 12+ 需声明厂商
             OpenCL 驱动库，LiteRT GPU 加速器才能 dlopen；全部 required=false（无 GPU
             的设备不受影响，CPU 为基线）。清单与官方 demo UniversalEmbedder 一致。 -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libGLES_mali.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZhiBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
