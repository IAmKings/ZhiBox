<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      联网路径：
      1) 用户显式触发的模型下载与网页导入；
      2) 用户配置并同意启用后的 OpenAI-compatible LLM 请求；
      3) 应用内更新：冷启动（24h 节流）匿名查询 GitHub Release，发现新版本且用户确认后
         下载 APK。检索/本地文件导入/嵌入全链路离线可用。
      依据：docs/SAG_Android_MVP_Implementation_Plan_v1.0.md P1-W1-5 / P1-W2-5；
      docs/product/APP_UPDATE_SPEC.md
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新：下载完成后拉起系统安装器（仅用于升级自身，不安装第三方 APK）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      P1-10 隐私边界：
      · allowBackup="false"：个人知识库（SQLite 中的原文 chunk / 向量 / 来源、
        SharedPreferences 中的 SAF 授权与模型偏好）禁止进入 Android Auto Backup
        （默认会随用户 Google 账户上云，与「本地优先 / 离线」定位冲突）。
        跨设备迁移只走产品自带的 KnowledgeBackup（用户显式导出/导入）。
      · networkSecurityConfig：所有网络路径都禁止明文流量；模型下载额外固定为
        hf-mirror.com，网页导入和用户配置的 LLM 端点由代码侧强制 HTTPS。
        详见 res/xml/network_security_config.xml。
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhiBox">

        <!-- GPU delegate（demo 保真差异②，2026-10-16 补齐）：Android 12+ 需声明厂商
             OpenCL 驱动库，LiteRT GPU 加速器才能 dlopen；全部 required=false（无 GPU
             的设备不受影响，CPU 为基线）。清单与官方 demo UniversalEmbedder 一致。 -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libGLES_mali.so" android:required="false" />

        <!--
          显式 adjustResize，避免默认 adjustUnspecified 在部分 ROM 上选成 adjustPan：
          窗口被平移 + Compose 的 imePadding 再次上推 = 悬浮输入岛被推离键盘很远。
          enableEdgeToEdge 下窗口不会被真正 resize，IME 只以 insets 形式下发，
          由首页输入岛的 imePadding() 负责贴住键盘。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZhiBox"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 应用内更新：把 cacheDir/updates 下的 APK 以 content:// 暴露给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
