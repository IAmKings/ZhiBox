{
  "schema_version": 1,
  "format": "agent_eval_cases",
  "description": "B17/P1.4 Agent 评测集（20 条）。离线 harness 只验证 route/fallback/evidence 去重/引用约束（契约回归），不代表真实回答质量；真实质量需用户 LLM key + 人工抽检（见 docs/review/P1_4_QUALITY_EVAL_PLAN.md）。",
  "prompt_version": "b16-agent-tools-v1",
  "not_for_real_quality_claim": true,
  "cases": [
    {
      "id": "fact-single-hop",
      "query": "光合作用主要发生在植物的哪个结构？",
      "history": [],
      "expectedToolRoute": [
        "search_knowledge",
        "final"
      ],
      "expectedFallback": null,
      "expectedCitationIds": [
        "S1"
      ],
      "notes": "事实题；单次检索→final，引用必须来自本轮 evidence"
    },
    {
      "id": "fact-multi-hop",
      "query": "上海这个城市在哪些事件里被提到？",
      "history": [],
      "expectedToolRoute": [
        "search_knowledge",
        "search_knowledge",
        "final"
      ],
      "expectedFallback": null,
      "expectedCitationIds": [
        "S1",
        "S2"
      ],
      "notes": "多跳；两次检索证据合并，按 chunkId 去重"
    },
    {
      "id": "multiturn-pronoun",
      "query": "他后来去哪了？",
